rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt']) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
             data.createdAt is string;
    }

    function isValidBookingInquiry(data) {
      return data.keys().hasAll(['userId', 'guestName', 'phone', 'checkInDate', 'checkOutDate', 'roomType', 'guestCount', 'status', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 100 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
             data.checkInDate is string && data.checkInDate.size() == 10 &&
             data.checkOutDate is string && data.checkOutDate.size() == 10 &&
             data.roomType is string && data.roomType.size() >= 2 && data.roomType.size() <= 50 &&
             data.guestCount is number && data.guestCount > 0 &&
             data.status is string && (data.status == 'pending' || data.status == 'confirmed' || data.status == 'cancelled') &&
             data.createdAt is string;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'authorName', 'rating', 'comment', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 500 &&
             data.createdAt is string;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
    }

    match /bookingInquiries/{inquiryId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid && isValidId(inquiryId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(inquiryId) && isValidBookingInquiry(incoming());
      allow update: if isSignedIn() && isValidId(inquiryId) && resource.data.userId == request.auth.uid && isValidBookingInquiry(incoming());
      allow delete: if isSignedIn() && isValidId(inquiryId) && resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(reviewId) && isValidReview(incoming());
      allow update: if isSignedIn() && isValidId(reviewId) && resource.data.userId == request.auth.uid && isValidReview(incoming());
      allow delete: if isSignedIn() && isValidId(reviewId) && resource.data.userId == request.auth.uid;
    }
  }
}
